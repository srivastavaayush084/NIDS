# ================================================================
# ZeroDayAI - Global Environment Configuration Template
# ================================================================

# Backend Configuration
PROJECT_NAME="ZeroDayAI - Zero-Day Attack Detection Platform"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"  # "development" | "production" | "testing"
DEBUG=True
LOG_LEVEL="INFO"
API_HOST="0.0.0.0"
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:8000"

# CORS Configuration (Comma-separated list of trusted origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# MongoDB Database Configuration (Never commit real credentials)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/"
MONGODB_DATABASE="zero_day_detection"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=2500

# Authentication & JWT Security Configuration
# NOTE: In production (ENVIRONMENT=production), JWT_SECRET_KEY MUST be a unique, cryptographically random secret >= 32 chars.
JWT_SECRET_KEY="dev-insecure-secret-key-change-in-production-1234567890"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# API Security, Rate Limiting & Protection
SECURITY_HEADERS_ENABLED=True
STRICT_TRANSPORT_SECURITY_ENABLED=False  # Enable only with HTTPS in production
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=10485760          # 10 MB in bytes
MAX_PCAP_FILE_BYTES=52428800             # 50 MB in bytes

# Storage Directories
MODEL_DIRECTORY="./ml_models/trained"
DATA_DIRECTORY="./data"
PREPROCESSING_DIR="./ml_models/preprocessing"

# Anomaly & Risk Scoring Thresholds
DEFAULT_ANOMALY_THRESHOLD=0.65
HIGH_RISK_THRESHOLD=0.85
CRITICAL_RISK_THRESHOLD=0.95
