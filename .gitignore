# ==============================================================================
# ZeroDayAI - Root Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
backend/.venv/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.venv/

# ------------------------------------------------------------------------------
# 2. Python Caches & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Testing & Coverage Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/
test-results/
playwright-report/
test-output/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Node Dependencies & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/.next/
frontend/.turbo/
.npm/
.eslintcache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secrets (NEVER COMMIT REAL CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.*
*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Explicitly preserve environment configuration templates
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.example
!.env.sample
!backend/.env.sample
!frontend/.env.sample

# ------------------------------------------------------------------------------
# 6. Datasets & Raw Data Archives (NO FULL DATASETS ON GITHUB)
# ------------------------------------------------------------------------------
# Ignore raw dataset contents while keeping directory hierarchy
data/raw/**/*
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/.gitkeep

# Ignore processed dataset contents while keeping directory hierarchy and synthetic test baseline
data/processed/**/*
!data/processed/**/
!data/processed/**/.gitkeep
!data/processed/.gitkeep
!data/processed/synthetic/**

# Ignore splits dataset contents while keeping directory structure
data/splits/**/*
!data/splits/**/
!data/splits/.gitkeep

# Ignore bulk dataset and tabular data formats across the repo
*.tsv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.npz

# Ignore archives
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.gz

# Preserve sample test fixtures & comparison CSVs
!data/sample/**
!ml_models/experiments/comparisons/*.csv

# ------------------------------------------------------------------------------
# 7. Network Captures & PCAP Files
# ------------------------------------------------------------------------------
*.pcap
*.pcapng
*.cap
data/**/*.pcap
tests/**/*.pcap
samples/**/*.pcap
uploads/**/*.pcap

# Explicitly preserve small test fixture sample PCAP (976 bytes) for smoke testing
!data/sample/sample_network_traffic.pcap

# ------------------------------------------------------------------------------
# 8. Machine Learning Artifacts & Checkpoints
# ------------------------------------------------------------------------------
# Ignore large generated model dumps and temporary checkpoints
*.ckpt
*.checkpoint
*.onnx
*.keras
ml_models/checkpoints/

# Preserve lightweight baseline pre-trained models (< 400 KB total), preprocessors,
# metadata, and registry required for out-of-the-box execution after cloning
!ml_models/trained/**
!ml_models/preprocessing/**
!ml_models/experiments/**
!ml_models/model_registry.json

# ------------------------------------------------------------------------------
# 9. Local Databases & Persistence Files
# ------------------------------------------------------------------------------
data/mongodb_data/
mongodb_data/
*.db
*.sqlite
*.sqlite3
*.wt
diagnostic.data/
mongod.lock
WiredTiger*

# ------------------------------------------------------------------------------
# 10. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.out

# ------------------------------------------------------------------------------
# 11. IDE & OS-Specific Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
